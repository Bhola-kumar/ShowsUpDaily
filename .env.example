# --- required ---
APP_PASSWORD=choose-a-strong-password
# Public URL of the deployed app (no trailing slash). Used for the Google OAuth redirect.
BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=

# --- optional ---
GEMINI_MODEL=gemini-2.5-flash
TZ_NAME=Asia/Kolkata
CONTENT_LANGUAGE=English
YOUTUBE_CATEGORY_ID=22
MAX_UPLOAD_MB=512
# Persistent folder for the database + videos
DATA_DIR=data
SECRET_KEY=
# For free hosts that sleep: an external pinger calls /cron/tick?key=<this>
CRON_KEY=
